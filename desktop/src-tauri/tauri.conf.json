{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orochi",
  "version": "0.1.0",
  "identifier": "dev.orochi.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orochi",
        "width": 1440,
        "height": 900,
        "minWidth": 860,
        "minHeight": 520,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
