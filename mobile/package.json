{
  "name": "orochi-mobile",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --check .",
    "start": "npm run start -w @orochi/app",
    "mock": "node tools/mock-server.mjs",
    "check": "npm run typecheck && npm test",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "pngjs": "7.0.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  }
}
